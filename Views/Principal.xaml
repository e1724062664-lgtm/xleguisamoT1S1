<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="xleguisamoT1S1.Views.Principal"
             Title="Principal">

    <ScrollView>

         <VerticalStackLayout Spacing="15" Padding="30">
            
             
             <Label 
              Text="Calculadora de Aporte al IESS"
                 FontSize="24"
                 FontAttributes="Bold"
                 VerticalOptions="Center" 
                 HorizontalOptions="Center" 
                 TextColor="Blue"
                 Margin="0,0,0,20"/>

            <!-- Nombre -->
            <Label Text="Nombre:" FontAttributes="Bold"/>
            <Entry x:Name="txtNombre" Placeholder="Ingrese su nombre"/>

            <!-- Apellido -->
            <Label Text="Apellido:" FontAttributes="Bold"/>
            <Entry x:Name="txtApellido" Placeholder="Ingrese su apellido"/>

            <!-- Edad -->
            <Label Text="Edad:" FontAttributes="Bold"/>
            <Entry x:Name="txtEdad" Placeholder="Ingrese su edad" Keyboard="Numeric"/>

            <!-- Salario -->
            <Label Text="Salario:" FontAttributes="Bold"/>
            <Entry x:Name="txtSalario" Placeholder="Ingrese su salario mensual" Keyboard="Numeric"/>

            <!-- Botón de Cálculo -->
            <Button Text="Calcular Aporte IESS"
                    Clicked="OnCalcularClicked"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    Margin="0,20,0,0"/>
        </VerticalStackLayout>

     </ScrollView>
</ContentPage>